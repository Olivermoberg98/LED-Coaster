<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color">

    <!-- CardView for content -->
    <androidx.cardview.widget.CardView
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/cardContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="8dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="@color/square_color"
        android:layout_margin="16dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <TextView
                android:id="@+id/text_games"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textSize="24sp"
                android:textStyle="bold"
                android:text="Games"
                android:layout_gravity="start"
                android:layout_marginBottom="8dp" />

            <Spinner
                android:id="@+id/spinnerCircleCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toRightOf="@id/text_games"
                android:backgroundTint="@color/white"
                android:layout_gravity="start"
                android:layout_margin="20dp"
                android:layout_alignBaseline="@id/text_games"/>

            <!-- RecyclerView for the previously connected devices -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerViewDevices"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/text_games"
                android:layout_marginTop="16dp"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

            <!-- Circle containers for device drag-and-drop -->
            <LinearLayout
                android:id="@+id/circleContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:layout_below="@id/recyclerViewDevices"
                android:layout_marginTop="16dp">
            </LinearLayout>
        </RelativeLayout>
    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:id="@+id/cardGameMode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="@color/square_color"
        android:layout_below="@id/cardContent">

        <LinearLayout
            android:id="@+id/layoutGameMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:gravity="center_horizontal">

            <Spinner
                android:id="@+id/spinnerGameMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:backgroundTint="@color/white"
                android:popupBackground="@color/background_color"
                android:spinnerMode="dropdown"
                android:textColor="@color/spinner_text_color" />

            <Button
                android:id="@+id/buttonStartGame"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Start Game"
                android:padding="12dp" />

            <!-- Game Status Feedback -->
            <TextView
                android:id="@+id/gameStatusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Game Status: Waiting"
                android:textSize="18sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:layout_marginTop="16dp"
                android:visibility="visible" />

            <!-- Progress Bar for In-Game State -->
            <ProgressBar
                android:id="@+id/gameProgressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:visibility="gone"
                android:indeterminate="true" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</RelativeLayout>
