# KiCad lock files, local history, backups and per-user view settings
~*.lck
.history/
*-backups/
*.kicad_prl
# KiCad's footprint cache and DRC/ERC reports; both regenerate on demand
fp-info-cache
*.rpt

# Python
__pycache__/
*.pyc

# IDE project files; Android Studio and IntelliJ regenerate them on sync
.idea/
